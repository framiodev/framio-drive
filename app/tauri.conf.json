{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framio Drive",
  "version": "0.2.2",
  "identifier": "app.framio.drive",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [ { "title": "Framio Drive", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600 } ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["Turkish", "English"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBKEY",
      "endpoints": ["https://github.com/framiodev/framio-drive/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

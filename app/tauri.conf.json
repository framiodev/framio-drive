{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framio Drive",
  "version": "0.39.2",
  "identifier": "app.framio.drive",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [ { "title": "Framio Drive", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600, "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows" } ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "winfsp.msi": "winfsp.msi" },
    "windows": { "nsis": { "installerHooks": "installer-hooks.nsh", "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["Turkish", "English"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBKEY",
      "endpoints": ["https://github.com/framiodev/framio-drive/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
